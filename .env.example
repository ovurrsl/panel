# MySQL 8 (InnoDB, utf8mb4)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=digitaltwin
DATABASE_PASSWORD=change-me
DATABASE_NAME=digitaltwin

# 32-byte base64 key used to encrypt TOTP secrets and webhook secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_ENCRYPTION_KEY=

# Cookie hardening. Set to 1 behind TLS.
SESSION_COOKIE_SECURE=0

# Optional. Names the 3D editor application so the sign-in hero can link to it.
# Unset means those links are simply not shown.
NEXT_PUBLIC_EDITOR_URL=

# Mail. "console" (default) prints messages with their links; "smtp" sends them.
MAIL_TRANSPORT=console
MAIL_FROM=DigitalTwin <no-reply@netlog.com.tr>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 1 forces implicit TLS; unset means implicit on 465, STARTTLS elsewhere.
SMTP_SECURE=
